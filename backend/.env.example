# Copy this file to .env and fill in real values. Never commit .env.

# Required
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require
SECRET_KEY=generate-with-python-c-"import secrets; print(secrets.token_hex(32))"

# Frontend address (CORS + links in emails)
FRONTEND_URL=http://localhost:3000

# Login cookie. Set COOKIE_SECURE=true when the site runs on HTTPS.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Gmail SMTP (use a Google App Password, not your Google account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=BuildCo
ADMIN_NOTIFY_EMAIL=

# Cloudflare Turnstile (leave empty in development: captcha is skipped)
TURNSTILE_SECRET_KEY=

# Cloudinary image uploads (leave empty until you set it up)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
